#include <bits/stdc++.h>
#define ll long long int
#define endl '\n'
using namespace std;

int main(){
    
    ios_base::sync_with_stdio(false);
    cin.tie(0);
    
    int n; cin >> n;
    int q; cin >> q;
    
    ll sum[n];
    
    for (int i = 0; i < n; i++){
        
        int num; cin >> num; 
        
        if (i == 0){
            
            sum[i] = num;
        }
        else{
            
            sum[i] = sum[i-1] + num;
        }
    }
    
    for (int i = 0; i < q; i++){
        int a; cin >> a;
        int b; cin >> b;
        
        if (a != 1){
            cout << sum[b-1] - sum[a-2] << endl;
        }
        else{
            
            cout << sum[b-1] << endl;
        }
    }

    
    
    return 0;
}
